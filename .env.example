# Copy to .env (git-ignored) and fill in. Variables already set in the shell take precedence.

# Public token (pk.*), embedded into output/<slug>/index.html for the preview
MAPBOX_ACCESS_TOKEN=

# `main.py publish --upload`: a SECRET token (sk.*) with tilesets:read / tilesets:write / tilesets:list. Never embedded.
MAPBOX_UPLOAD_TOKEN=
